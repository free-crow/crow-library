# ===== Crow Library 环境变量示例（复制为 .env.local 并填写自己的值） =====
# 安全要求：API 密钥、数据库密码等绝不提交到公开仓库，也不要发到聊天或截图里。

# Supabase（认证 + 数据库 + 存储）。未配置时应用以“本地演示模式”运行。
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# PostgreSQL 直连（服务端使用，可选）
DATABASE_URL=

# AI 大语言模型 API（第 7 阶段启用；仅对授权允许 AI 处理的书籍开放）
AI_API_KEY=
AI_API_BASE=
AI_MODEL=

# 站点
NEXT_PUBLIC_SITE_NAME=乌鸦的图书馆

# 管理员邮箱（逗号分隔，可填多个；不填则使用演示账号 admin@crow.lib）
NEXT_PUBLIC_ADMIN_EMAILS=admin@crow.lib
